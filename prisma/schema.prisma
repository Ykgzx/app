// Prisma Schema สำหรับระบบจัดการวัสดุเทศบาล (Municipal Equipment Management System)
// ปรับให้ตรงกับโครงสร้างฐานข้อมูลจริง

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}
// -------------------------------------------------------------
// Enums
// -------------------------------------------------------------
enum request_type {
  BORROW
  WITHDRAW
}

enum request_status {
  PENDING
  APPROVED
  REJECTED
  BORROWING
  RETURNED
  CANCELLED
}

enum approval_result {
  APPROVED
  REJECTED
}

enum stock_movement_type {
  IN
  OUT
  RETURN
}

// -------------------------------------------------------------
// บทบาท (Role)
// -------------------------------------------------------------
model Role {
  id          Int      @id @default(autoincrement())
  role_name   String   @db.VarChar(50)
  description String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(6)

  users User[]

  @@map("roles")
}

// -------------------------------------------------------------
// แผนก/กอง (Department)
// -------------------------------------------------------------
model Department {
  id              Int      @id @default(autoincrement())
  department_name String   @db.VarChar(150)
  description     String?  @db.Text
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @updatedAt @db.Timestamp(6)

  users User[]

  @@map("departments")
}

// -------------------------------------------------------------
// ผู้ใช้งานระบบ (User)
// -------------------------------------------------------------
model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique @db.VarChar(100)
  password_hash String?  @db.Text
  first_name    String   @db.VarChar(100)
  last_name     String   @db.VarChar(100)
  email         String   @unique @db.VarChar(255)
  phone         String?  @db.VarChar(20)
  role_id       Int
  department_id Int
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)

  role       Role       @relation(fields: [role_id], references: [id])
  department Department @relation(fields: [department_id], references: [id])

  requests             Request[]
  returns              Return[]
  stock_replenishments StockReplenishment[]
  audit_logs           AuditLog[]

  @@map("users")
}

// -------------------------------------------------------------
// หมวดหมู่วัสดุ (Category)
// -------------------------------------------------------------
model Category {
  id            Int      @id @default(autoincrement())
  category_name String   @db.VarChar(150)
  description   String?  @db.Text
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)

  materials Material[]

  @@map("categories")
}

// -------------------------------------------------------------
// วัสดุและครุภัณฑ์ (Material)
// -------------------------------------------------------------
model Material {
  id             Int      @id @default(autoincrement())
  material_code  String   @unique @db.VarChar(50)
  material_name  String   @db.VarChar(255)
  category_id    Int
  item_type      String?  @db.VarChar(50)
  description    String?  @db.Text
  unit           String?  @db.VarChar(50)
  stock_quantity Int      @default(0)
  minimum_stock  Int      @default(0)
  image_url      String?  @db.Text
  location       String?  @db.VarChar(255)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @updatedAt @db.Timestamp(6)

  category Category @relation(fields: [category_id], references: [id])

  request_items        RequestItem[]
  return_items         ReturnItem[]
  stock_movements      StockMovement[]
  stock_replenishments StockReplenishment[]

  @@map("materials")
}

// -------------------------------------------------------------
// คำขอ (Request)
// -------------------------------------------------------------
model Request {
  id           Int            @id @default(autoincrement())
  request_code String         @unique @db.VarChar(50)
  user_id      Int
  request_type request_type
  status       request_status
  reason       String?        @db.Text
  borrow_date  DateTime?      @db.Date
  due_date     DateTime?      @db.Date
  created_at   DateTime       @default(now()) @db.Timestamp(6)
  updated_at   DateTime       @updatedAt @db.Timestamp(6)

  user          User          @relation(fields: [user_id], references: [id])
  request_items RequestItem[]
  returns       Return[]

  @@map("requests")
}

// -------------------------------------------------------------
// รายการวัสดุในคำขอ (Request Item)
// -------------------------------------------------------------
model RequestItem {
  id          Int      @id @default(autoincrement())
  request_id  Int
  material_id Int
  quantity    Int
  created_at  DateTime @default(now()) @db.Timestamp(6)

  request  Request  @relation(fields: [request_id], references: [id])
  material Material @relation(fields: [material_id], references: [id])

  @@map("request_items")
}

// -------------------------------------------------------------
// การอนุมัติ (Approval)
// -------------------------------------------------------------
model Approval {
  id          Int             @id @default(autoincrement())
  request_id  Int
  approver_id Int
  result      approval_result
  reason      String?         @db.Text
  approved_at DateTime        @default(now()) @db.Timestamp(6)

  @@map("approvals")
}

// -------------------------------------------------------------
// การคืนวัสดุ (Return)
// -------------------------------------------------------------
model Return {
  id          Int       @id @default(autoincrement())
  return_code String    @unique @db.VarChar(50)
  request_id  Int
  user_id     Int
  return_date DateTime? @db.Date
  note        String?   @db.Text
  created_at  DateTime  @default(now()) @db.Timestamp(6)

  request Request @relation(fields: [request_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])

  return_items ReturnItem[]

  @@map("returns")
}

// -------------------------------------------------------------
// รายการวัสดุที่คืน (Return Item)
// -------------------------------------------------------------
model ReturnItem {
  id          Int      @id @default(autoincrement())
  return_id   Int
  material_id Int
  quantity    Int
  condition   String?  @db.VarChar(100)
  note        String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(6)

  return_   Return   @relation(fields: [return_id], references: [id])
  material  Material @relation(fields: [material_id], references: [id])

  @@map("return_items")
}

// -------------------------------------------------------------
// ความเคลื่อนไหวสต็อก (Stock Movement)
// -------------------------------------------------------------
model StockMovement {
  id            Int                 @id @default(autoincrement())
  material_id   Int
  movement_type stock_movement_type
  quantity      Int
  reference_id  Int?
  note          String?             @db.Text
  created_by    Int?
  created_at    DateTime            @default(now()) @db.Timestamp(6)

  material Material @relation(fields: [material_id], references: [id])

  @@map("stock_movements")
}

// -------------------------------------------------------------
// การเติมสต็อก (Stock Replenishment)
// -------------------------------------------------------------
model StockReplenishment {
  id           Int      @id @default(autoincrement())
  material_id  Int
  quantity     Int
  supplier     String?  @db.VarChar(255)
  reference_no String?  @db.VarChar(100)
  note         String?  @db.Text
  added_by     Int?
  created_at   DateTime @default(now()) @db.Timestamp(6)

  material Material @relation(fields: [material_id], references: [id])
  user     User?    @relation(fields: [added_by], references: [id])

  @@map("stock_replenishments")
}

// -------------------------------------------------------------
// บันทึกประวัติการทำงาน (Audit Log)
// -------------------------------------------------------------
model AuditLog {
  id          Int      @id @default(autoincrement())
  user_id     Int?
  action      String   @db.VarChar(100)
  table_name  String   @db.VarChar(100)
  record_id   Int?
  description String?  @db.Text
  ip_address  String?  @db.VarChar(45)
  created_at  DateTime @default(now()) @db.Timestamp(6)

  user User? @relation(fields: [user_id], references: [id])

  @@map("audit_logs")
}
